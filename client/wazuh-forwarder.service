[Unit]
Description=Wazuh Alert Forwarder to ELK
# This service should start after the network is available.
After=network-online.target
Wants=network-online.target

[Service]
# The user that will run the script. Ensure this user has read access
# to the wazuh alerts file and write access to its own log and state files.
# Running as root is simple but consider a less privileged user for better security.
User=root

# The location of your Python script.
ExecStart=/usr/bin/python3 /opt/wazuh-forwarder/forwarder.py

# This command runs before ExecStart and ensures the directory for our state
# file exists, making the service more robust on first run.
ExecStartPre=/bin/mkdir -p /var/lib/wazuh-forwarder
ExecStartPre=/bin/chown root:root /var/lib/wazuh-forwarder

# This is critical for graceful shutdown.
# systemd will send a SIGINT (equivalent to Ctrl+C) and wait for the script
# to exit. Our Python script is designed to catch this signal.
KillSignal=SIGINT

# If the script exits cleanly (exit code 0), wait before restarting.
# This prevents rapid restarts if a file is temporarily unavailable.
SuccessExitStatus=0
RestartSec=15

# For any other exit code (i.e., a crash), restart immediately.
Restart=on-failure
RestartSec=5

# The script handles its own logging, so we don't need systemd to pipe it to syslog.
# You can view startup errors and process info with `journalctl -u wazuh-forwarder.service`.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
